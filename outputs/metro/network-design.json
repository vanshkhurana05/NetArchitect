    "explanations": [
      {
        "id": "ROUTING.PROTOCOL.MULTI-AREA-OSPF",
        "module": "routing",
        "rule": "ROUTING.02",
        "decision": "Selected Multi-Area OSPF architecture with Area 0 backbone",
        "rationale": "Multi-site topology (3 sites) requires routing-domain isolation. Hierarchical area design isolates LSA flooding, reduces SPF recalculation frequency, and enforces area boundary summarization.",
        "inputs": {
          "asNumber": 65001,
          "subnetCount": 4,
          "threshold": 50,
          "sitesCount": 3
        },
        "references": [
          "RFC 2328 OSPFv2 Section 3.2",
          "RFC 3509 Alternative OSPF ABR Implementations"
        ]
      },
      {
        "id": "ROUTING.OSPF.AREAS",
        "module": "routing",
        "rule": "ROUTING.04",
        "decision": "Configured 1 OSPF area(s) with 4 network statements",
        "rationale": "Network statements map exact network-aligned CIDRs and inverse wildcard masks directly from the VLSM plan, ensuring flawless LSDB population.",
        "inputs": {
          "areasCount": 1,
          "totalNetworks": 4
        },
        "references": [
          "RFC 2328 Section 3.1",
          "RFC 1878"
        ]
      },
      {
        "id": "ROUTING.QOS.DIFFSERV-QUEUING",
        "module": "qos",
        "rule": "QOS.01",
        "decision": "Configured 4-class DiffServ QoS policy on EVPL provider circuits",
        "rationale": "Classifies EF Voice (30% priority queue) and AF31 Transactional data (40% bandwidth queue) to guarantee sub-5ms SLA latency under congestion.",
        "inputs": {
          "classes": [
            "VOICE-EF",
            "TRANSACTIONAL-AF31",
            "VIDEO-AF21",
            "DEFAULT-BEST-EFFORT"
          ]
        },
        "references": [
          "RFC 4594 DiffServ Class Architecture",
          "RFC 3246 Expedited Forwarding"
        ]
      },
      {
        "id": "ROUTING.FAILOVER.METRIC-STEERING",
        "module": "routing",
        "rule": "ROUTING.06",
        "decision": "Planned deterministic route failover across 2 circuit pair(s)",
        "rationale": "Primary circuits are biased with metric 10 while secondary circuits carry metric 20, guaranteeing hitless failover upon primary link flap.",
        "inputs": {
          "failoverPairs": 2
        },
        "references": [
          "Cisco Resilient Network Design",
          "RFC 2328 Cost Metric Semantics"
        ]
      }
    ],
    "qos": [
