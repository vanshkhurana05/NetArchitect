    "explanations": [
      {
        "id": "VLAN.DETERMINISTIC-TAGS",
        "module": "vlan",
        "rule": "VLAN.01",
        "decision": "Assigned deterministic 802.1Q tags starting at 10 (+10)",
        "rationale": "Standardized VLAN numbering ensures uniform broadcast domain mapping across campus switches and prevents conflicting PVIDs.",
        "inputs": {
          "totalVlans": 6,
          "startId": 10,
          "increment": 10
        },
        "references": [
          "IEEE 802.1Q",
          "Cisco Campus LAN Best Practices"
        ]
      },
      {
        "id": "VLAN.NATIVE-HARDENING",
        "module": "vlan",
        "rule": "VLAN.02",
        "decision": "Configured Native VLAN 99 as untagged and unused on all trunks",
        "rationale": "Setting the native VLAN to an unused ID (VLAN 99) and disallowing default VLAN 1 mitigates 802.1Q double-tagging and VLAN hopping security vulnerabilities.",
        "inputs": {
          "nativeVlanId": 99,
          "defaultVlanDisabled": 1
        },
        "references": [
          "NIST SP 800-115",
          "DISA Network Infrastructure STIG"
        ]
      },
      {
        "id": "VLAN.TRUNK-PRUNING",
        "module": "vlan",
        "rule": "VLAN.03",
        "decision": "Restricted trunk links to explicitly allowed VLAN list [10,20,30,40,50,60]",
        "rationale": "Explicit allowed-VLAN pruning confines broadcast/multicast traffic strictly to authorized switches, conserving backplane bandwidth.",
        "inputs": {
          "allowedVlanIds": [
            10,
            20,
            30,
            40,
            50,
            60
          ]
        },
        "references": [
          "IEEE 802.1Q Clause 9",
          "RFC 3069"
        ]
      }
    ]
  },
