    "explanations": [
      {
        "id": "TOPO.CAMPUS-COLLAPSED-CORE",
        "module": "topology",
        "rule": "TOPO.01",
        "decision": "Deployed 2 redundant L3 Core switches in collapsed-core topology",
        "rationale": "Collapsed-core topology combines core and distribution functions for campuses < 5,000 endpoints, providing high availability with lower operational complexity.",
        "inputs": {
          "buildingsCount": 3,
          "coreSwitches": 2
        },
        "references": [
          "Cisco Campus LAN Design Guide",
          "IEEE 802.1D RSTP"
        ]
      },
      {
        "id": "TOPO.BUILDING-PLAN.SCI",
        "module": "topology",
        "rule": "TOPO.02",
        "decision": "Sized 18 access switches for SCI (represented as ACC-SCI Stack for deployment)",
        "rationale": "Building Science & Engineering Hall (SCI): 650 endpoints with 20% growth buffer require 780 active drops. Using 48-port switches with 4 reserved uplink ports yields 44 usable access ports per switch. Allocated 18 access switch(es) providing 792 total access ports (12 spare ports). Calculated 28 PoE+ wireless access points (24 endpoints per AP). Allocated 1 distribution switch/stack for building aggregation. Aggregated into a representative Catalyst Stack for streamlined Packet Tracer / GNS3 verification.",
        "inputs": {
          "endpoints": 650,
          "accessSwitches": 18,
          "apCount": 28
        },
        "references": [
          "IEEE 802.3at PoE+",
          "ANSI/TIA-568.0-D",
          "Cisco Catalyst StackWise Architecture"
        ]
      },
      {
        "id": "TOPO.BUILDING-PLAN.ADM",
        "module": "topology",
        "rule": "TOPO.02",
        "decision": "Sized 11 access switches for ADM (represented as ACC-ADM Stack for deployment)",
        "rationale": "Building Administrative Complex (ADM): 400 endpoints with 20% growth buffer require 480 active drops. Using 48-port switches with 4 reserved uplink ports yields 44 usable access ports per switch. Allocated 11 access switch(es) providing 484 total access ports (4 spare ports). Calculated 17 PoE+ wireless access points (24 endpoints per AP). Allocated 1 distribution switch/stack for building aggregation. Aggregated into a representative Catalyst Stack for streamlined Packet Tracer / GNS3 verification.",
        "inputs": {
          "endpoints": 400,
          "accessSwitches": 11,
          "apCount": 17
        },
        "references": [
          "IEEE 802.3at PoE+",
          "ANSI/TIA-568.0-D",
          "Cisco Catalyst StackWise Architecture"
        ]
      },
      {
        "id": "TOPO.BUILDING-PLAN.LIB",
        "module": "topology",
        "rule": "TOPO.02",
        "decision": "Sized 15 access switches for LIB (represented as ACC-LIB Stack for deployment)",
        "rationale": "Building Central Library & Tech Hub (LIB): 550 endpoints with 20% growth buffer require 660 active drops. Using 48-port switches with 4 reserved uplink ports yields 44 usable access ports per switch. Allocated 15 access switch(es) providing 660 total access ports (0 spare ports). Calculated 23 PoE+ wireless access points (24 endpoints per AP). Allocated 1 distribution switch/stack for building aggregation. Aggregated into a representative Catalyst Stack for streamlined Packet Tracer / GNS3 verification.",
        "inputs": {
          "endpoints": 550,
          "accessSwitches": 15,
          "apCount": 23
        },
        "references": [
          "IEEE 802.3at PoE+",
          "ANSI/TIA-568.0-D",
          "Cisco Catalyst StackWise Architecture"
        ]
      }
    ]
  },
