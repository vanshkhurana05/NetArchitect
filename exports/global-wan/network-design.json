    "explanations": [
      {
        "id": "ROUTING.PROTOCOL.OSPF-EBGP",
        "module": "routing",
        "rule": "ROUTING.03",
        "decision": "Selected OSPF + eBGP multi-domain routing architecture",
        "rationale": "Enterprise Autonomous System AS 65001 connects to external Cloud VPC boundary. eBGP handles policy-based inter-AS exchange (RFC 4271), while multi-area OSPF isolates internal enterprise areas.",
        "inputs": {
          "asNumber": 65001,
          "subnetCount": 4,
          "cloudVpcProvider": "aws",
          "distinctAutonomousSystems": true
        },
        "references": [
          "RFC 4271 BGP-4",
          "RFC 4364 BGP/MPLS IP VPNs",
          "RFC 2328 OSPFv2"
        ]
      },
      {
        "id": "ROUTING.OSPF.AREAS",
        "module": "routing",
        "rule": "ROUTING.04",
        "decision": "Configured 1 OSPF area(s) with 4 network statements",
        "rationale": "Network statements map exact network-aligned CIDRs and inverse wildcard masks directly from the VLSM plan, ensuring flawless LSDB population.",
        "inputs": {
          "areasCount": 1,
          "totalNetworks": 4
        },
        "references": [
          "RFC 2328 Section 3.1",
          "RFC 1878"
        ]
      },
      {
        "id": "ROUTING.BGP.EBGP-PEERING",
        "module": "routing",
        "rule": "ROUTING.05",
        "decision": "Established eBGP peering between Enterprise AS 65001 and Cloud Provider AS 64512",
        "rationale": "eBGP session advertises summarized enterprise supernet towards Cloud VPC peer IP to prevent routing table bloat and enforce policy separation.",
        "inputs": {
          "localAs": 65001,
          "remoteAs": 64512,
          "peerIps": [
            "203.0.113.10",
            "203.0.113.11"
          ]
        },
        "references": [
          "RFC 4271 BGP-4",
          "RFC 6996 Autonomous System Number Reservation"
        ]
      },
      {
        "id": "ROUTING.SECURITY.IPSEC-IKEV2",
        "module": "security",
        "rule": "SEC.01",
        "decision": "Configured 2 IKEv2 site-to-site IPsec tunnel(s) toward Cloud VPC",
        "rationale": "IKEv2 protects transit between enterprise border routers and Cloud VPC with AES-256-GCM encryption and SHA-384 integrity (RFC 7296).",
        "inputs": {
          "tunnelsCount": 2,
          "peerIps": [
            "203.0.113.10",
            "203.0.113.11"
          ]
        },
        "references": [
          "RFC 7296 IKEv2",
          "NIST SP 800-77"
        ]
      },
      {
        "id": "ROUTING.FAILOVER.METRIC-STEERING",
        "module": "routing",
        "rule": "ROUTING.06",
        "decision": "Planned deterministic route failover across 1 circuit pair(s)",
        "rationale": "Primary circuits are biased with metric 10 while secondary circuits carry metric 20, guaranteeing hitless failover upon primary link flap.",
        "inputs": {
          "failoverPairs": 1
        },
        "references": [
          "Cisco Resilient Network Design",
          "RFC 2328 Cost Metric Semantics"
        ]
      }
    ]
