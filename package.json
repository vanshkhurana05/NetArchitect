{
  "name": "netarchitect",
  "version": "0.1.0",
  "description": "NetArchitect: algorithmic network planning & self-explaining architecture engine (CIC-307)",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "netarch": "dist/orchestrator/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:campus": "tsx src/orchestrator/cli.ts run --preset campus-lan --out outputs",
    "design:metro": "tsx src/orchestrator/cli.ts run --preset metro-man --out outputs",
    "design:global": "tsx src/orchestrator/cli.ts run --preset global-wan --out outputs",
    "design:all": "npm run design:campus && npm run design:metro && npm run design:global",
    "example:profiles": "tsx examples/run-profiles-demo.ts",
    "example:media": "tsx examples/run-media-demo.ts",
    "example:vlsm": "tsx examples/run-vlsm-demo.ts",
    "example:topology-vlan": "tsx examples/run-topology-vlan-demo.ts",
    "example:routing": "tsx examples/run-routing-demo.ts",
    "example:configgen": "tsx examples/generate-sample-configs.ts",
    "example:report": "tsx examples/run-report-demo.ts",
    "run:campus": "tsx examples/run-campus-lan.ts",
    "run:metro": "tsx examples/run-metro-man.ts",
    "run:wan": "tsx examples/run-global-wan.ts",
    "run:custom": "tsx examples/run-custom-input.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
